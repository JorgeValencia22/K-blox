{
  "name": "kest-worlds",
  "version": "0.1.0",
  "private": true,
  "description": "KestWorlds - plataforma de mundos 3D multijugador (Three.js + Socket.IO + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:init": "node server/db/init.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "covers": "node scripts/covers.js",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@libsql/client": "^0.18.0",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "vite": "^6.0.7"
  },
  "main": "electron-main.cjs",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.jorge.kestworlds",
    "productName": "Kest Worlds",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-main.cjs",
      "package.json",
      "Logo-azul-juego.ico",
      "Logo-rojo-instalación.ico",
      "!android/**",
      "!ios/**"
    ],
    "win": {
      "icon": "Logo-azul-juego.ico"
    },
    "nsis": {
      "installerIcon": "Logo-rojo-instalación.ico",
      "uninstallerIcon": "Logo-rojo-instalación.ico"
    }
  }
}
