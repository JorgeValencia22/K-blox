{
  "name": "kest-worlds",
  "version": "0.1.0",
  "private": true,
  "description": "Kest Worlds - plataforma de mundos 3D multijugador (Three.js + Socket.IO + SQLite)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "db:init": "node server/db/init.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "three": "^0.170.0",
    "vite": "^6.0.7"
  }
}
