# Copia este archivo como ".env" y ajusta los valores. No incluyas secretos reales en el repositorio.

# Puerto del servidor de juego (API + Socket.IO + cliente compilado)
PORT=3000
HOST=0.0.0.0

# Si el juego está detrás de un proxy (Render, Railway, Fly, Cloudflare Tunnel, nginx) pon 1
TRUST_PROXY=0

# Archivo SQLite
DB_FILE=data/kest.db

# Nombre de este servidor (preparado para varios servidores de juego)
SERVER_NAME=kest-1

# Límites
MAX_CONNECTIONS=200
MAX_PLAYERS_PER_ROOM=24

# Duración de las sesiones (días)
SESSION_DAYS=14

# Minutos durante los que una cuenta nueva tiene el chat restringido
NEW_ACCOUNT_MINUTES=30

# Monedas iniciales de cada cuenta
STARTING_COINS=100

# Usuarios con rol de moderador (separados por comas). Se aplica al registrarse.
ADMIN_USERNAMES=

# Lista de palabras filtradas en el chat
FILTER_WORDS_FILE=server/security/filter-words.json

# Cuenta del dueño con modo desarrollador (cerrar servidores, espectear, controlar...).
# Se crea o actualiza al arrancar. NO subas la contraseña a GitHub: ponla solo en .env o en el panel del hosting.
OWNER_USERNAME=
OWNER_PASSWORD=
